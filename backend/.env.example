# Copy to backend/.env; configure production secrets explicitly.
APP_NAME=RadioManager
DEBUG=false
WORKERS=1
ENVIRONMENT=development
DATABASE_MODE=sqlite
SQLITE_URL=sqlite:///./radiomanager.db
DATABASE_URL=
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@radiomanager.local
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:7777"]
DX_CLUSTER_NODES=[]
UDP_ENABLED=false
UDP_BIND_HOST=127.0.0.1
UDP_ALLOWED_SOURCES=["127.0.0.1","::1"]
UDP_WSJTX_PORT=2237
UDP_N1MM_PORT=12060
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=uploads
